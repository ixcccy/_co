// File name: projects/01/Or8Way.hdl

/**
 * 8-way Or: 
 * out = (in[0] or in[1] or ... or in[7])
 */

CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    // Put your code here:
// 第一層：兩兩做 Or
    Or(a=in[0], b=in[1], out=w1);
    Or(a=in[2], b=in[3], out=w2);
    Or(a=in[4], b=in[5], out=w3);
    Or(a=in[6], b=in[7], out=w4);

    // 第二層：把第一層的結果兩兩做 Or
    Or(a=w1, b=w2, out=w5);
    Or(a=w3, b=w4, out=w6);

    // 第三層：得出最終 Or8Way 的結果
    Or(a=w5, b=w6, out=out);
}
